# Docker Compose 环境变量示例，复制为 .env 后按需修改
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=sky_take_out
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=sky
RABBITMQ_DEFAULT_PASS=sky123

# 本地/容器内未配置真实小程序时保持 true（用 code 派生 mock openid）
WECHAT_MOCK=true
